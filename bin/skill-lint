#!/usr/bin/env node
// Structural checks for skills/. No model calls, runs in about a second.
//
//   bin/skill-lint            check skills/
//   bin/skill-lint <dir>      check another skills dir (e.g. work/brayness/skills)
//
// Catches the failure modes that have actually shipped here: frontmatter that
// does not parse, descriptions over the limit, reference links pointing at
// missing files, cross-references to skills that no longer exist, and
// .skill-lock.json entries whose folders are gone.

import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const here = path.dirname(fileURLToPath(import.meta.url))
const root = path.resolve(here, '..')
const skills_dir = path.resolve(process.argv[2] || path.join(root, 'skills'))

const DESCRIPTION_LIMIT = 1024

const problems = []
const fail = (skill, check, detail) => problems.push({ skill, check, detail })

const skill_names = fs
  .readdirSync(skills_dir)
  .filter((d) => fs.existsSync(path.join(skills_dir, d, 'SKILL.md')))
  .sort()

// Pass 1: frontmatter parses, required fields, description length.
const frontmatter = new Map()

for (const name of skill_names) {
  const file = path.join(skills_dir, name, 'SKILL.md')
  const text = fs.readFileSync(file, 'utf8')

  if (!text.startsWith('---')) {
    fail(name, 'frontmatter', 'no frontmatter block')
    continue
  }

  let doc
  try {
    doc = parseFrontmatter(text)
  } catch (error) {
    fail(name, 'frontmatter', error.message.split('\n')[0])
    continue
  }

  if (!doc || typeof doc !== 'object') {
    fail(name, 'frontmatter', 'did not parse to a mapping')
    continue
  }

  frontmatter.set(name, doc)

  if (!doc.name) fail(name, 'frontmatter', 'missing name')
  else if (doc.name !== name) fail(name, 'frontmatter', `name is "${doc.name}", folder is "${name}"`)

  const description = doc.description || ''
  if (!description) fail(name, 'frontmatter', 'missing description')
  else if (description.length > DESCRIPTION_LIMIT)
    fail(name, 'description', `${description.length} chars, limit ${DESCRIPTION_LIMIT}`)
}

// Pass 2: markdown links into references/ resolve to real files.
for (const name of skill_names) {
  const skill_root = path.join(skills_dir, name)

  for (const file of walk(skill_root).filter((f) => f.endsWith('.md'))) {
    const text = strip_code(fs.readFileSync(file, 'utf8'))
    const links = text.matchAll(/\]\((?!https?:|#|mailto:|<)([^)#\s]+)(?:#[^)]*)?\)/g)

    for (const [, target] of links) {
      const resolved = path.resolve(path.dirname(file), target)
      if (!fs.existsSync(resolved))
        fail(name, 'dead-link', `${path.relative(skills_dir, file)} -> ${target}`)
    }
  }
}

// Pass 3: cross-references name skills that exist.
const known = new Set(skill_names)

for (const [name, doc] of frontmatter) {
  if (!Array.isArray(doc.pairsWith)) continue

  for (const target of doc.pairsWith) {
    if (target && !known.has(target)) fail(name, 'dead-skill-ref', `pairs-with "${target}"`)
  }
}

// Pass 4: lock entries still correspond to folders on disk.
const lock_path = path.join(root, '.skill-lock.json')

if (fs.existsSync(lock_path) && skills_dir === path.join(root, 'skills')) {
  const lock = JSON.parse(fs.readFileSync(lock_path, 'utf8'))

  for (const name of Object.keys(lock.skills || {}))
    if (!known.has(name)) fail(name, 'stale-lock', '.skill-lock.json entry has no folder')
}

// Report.
console.log(`${skill_names.length} skills in ${path.relative(root, skills_dir) || skills_dir}`)

if (!problems.length) {
  console.log('clean')
  process.exit(0)
}

const width = Math.max(...problems.map((p) => p.skill.length))
for (const { skill, check, detail } of problems)
  console.log(`  ${skill.padEnd(width)}  ${check.padEnd(14)}  ${detail}`)

console.log(`\n${problems.length} problem${problems.length === 1 ? '' : 's'}`)
process.exit(1)

// A small YAML subset parser for skill frontmatter. It handles the shapes the
// repo actually uses: `key: value`, folded/literal blocks (`>-`, `|`), and a
// `pairs-with:` list nested under `metadata:`. Keeping it local avoids a
// node_modules dependency and makes the linter work on a fresh checkout.
function parseFrontmatter(text) {
  const match = text.match(/^---\s*\n([\s\S]*?)\n---\s*(?:\n|$)/)
  if (!match) throw new Error('no frontmatter block')

  const lines = match[1].split('\n')
  const doc = {}
  const unquote = (value) => value.trim().replace(/^["']|["']$/g, '')

  const collectBlock = (start, parentIndent) => {
    const collected = []
    let index = start
    while (index < lines.length) {
      const line = lines[index]
      if (!line.trim()) { index++; continue }
      if (line.match(/^\s*/)[0].length <= parentIndent) break
      collected.push(line.trim())
      index++
    }
    return { value: collected.join(' ').replace(/\s+/g, ' ').trim(), next: index }
  }

  for (let index = 0; index < lines.length; index++) {
    const line = lines[index]
    if (!line.trim() || line.trim().startsWith('#')) continue

    const nameMatch = line.match(/^name:\s*(.*)$/)
    if (nameMatch) {
      doc.name = unquote(nameMatch[1])
      continue
    }

    const descriptionMatch = line.match(/^description:\s*(.*)$/)
    if (descriptionMatch) {
      const raw = descriptionMatch[1].trim()
      if (['>', '>-', '|', '|-'].includes(raw) || raw === '') {
        const block = collectBlock(index + 1, 0)
        doc.description = block.value
        index = block.next - 1
      } else {
        doc.description = unquote(raw)
      }
      continue
    }

    const pairsMatch = line.match(/^(\s*)pairs-with:\s*$/)
    if (pairsMatch) {
      const parentIndent = pairsMatch[1].length
      const pairs = []
      let cursor = index + 1
      while (cursor < lines.length) {
        const pairLine = lines[cursor]
        if (!pairLine.trim()) { cursor++; continue }
        const indent = pairLine.match(/^\s*/)[0].length
        const body = pairLine.trim()
        if (!body.startsWith('- ') && indent <= parentIndent) break
        if (body.startsWith('- ')) {
          const item = body.slice(2).trim()
          const skillMatch = item.match(/^skill:\s*(.+)$/)
          if (skillMatch) pairs.push(unquote(skillMatch[1]))
          else if (!item.includes(':')) pairs.push(unquote(item))
        }
        cursor++
      }
      doc.pairsWith = pairs
      index = cursor - 1
    }
  }

  return doc
}

// Fenced blocks and inline code hold example paths, not real links.
function strip_code(text) {
  return text.replace(/^```[\s\S]*?^```/gm, '').replace(/`[^`\n]*`/g, '')
}

function walk(dir) {
  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => {
    const full = path.join(dir, entry.name)
    return entry.isDirectory() ? walk(full) : [full]
  })
}
